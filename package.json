{
  "name": "freeknet",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "deploy": "./deploy/deploy.sh",
    "start": "concurrently -k -n server,client -c blue,green \"npm run server\" \"npm run dev\"",
    "smoke": "tsx smoketest/multiplayer.ts",
    "smoke:auth": "tsx smoketest/auth.ts",
    "smoke:instancing": "tsx smoketest/instancing.ts",
    "smoke:rovers": "tsx smoketest/rovers.ts",
    "smoke:rover-ui": "tsx smoketest/rover-ui.ts",
    "smoke:handshake": "tsx smoketest/handshake.ts",
    "smoke:chat": "tsx smoketest/chat.ts",
    "smoke:visual": "tsx smoketest/visual.ts",
    "smoke:presence": "tsx smoketest/presence.ts",
    "smoke:player-physics": "tsx smoketest/player-physics.ts",
    "smoke:all": "npm run smoke && npm run smoke:chat && npm run smoke:presence && npm run smoke:player-physics && npm run smoke:auth && npm run smoke:rover-ui && npm run smoke:instancing && npm run smoke:rovers && npm run smoke:handshake"
  },
  "dependencies": {
    "@perplexdotgg/bounce": "^1.8.1",
    "@perplexdotgg/bounce-character-controller": "^0.3.0",
    "better-sqlite3": "^12.10.0",
    "three": "^0.160.0",
    "troika-three-text": "^0.49.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.4",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^8.2.2",
    "esbuild": "^0.24.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "puppeteer": "^23.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0"
  }
}
